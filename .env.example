# LINE Messaging API Channel Access Token (建議以 wrangler secret 設定至 Worker)
LINE_CHANNEL_ACCESS_TOKEN="your_channel_access_token_here"

# LINE Login Channel ID (用於驗證前端傳入的 ID Token)
LINE_LOGIN_CHANNEL_ID="your_line_login_channel_id"

# LIFF ID (供前端 ApplyForm 與後端推播卡片跳轉使用)
VITE_LIFF_ID="your_liff_id_here"
LIFF_ID="your_liff_id_here"

# 服務站/單位名稱 (選填，預設為「農業服務站」)
STATION_NAME="高雄服務站"
VITE_STATION_NAME="高雄服務站"

# 前端呼叫的後端 API 網址 (選填，若前端與後端分開部署可填入 Worker 網址，如 https://line-bot-farm-api.<subdomain>.workers.dev；留空則走同源 Pages Functions 反向代理)
VITE_API_BASE_URL=""

# Cloudflare Turnstile Site Key (前端表單無感真人驗證，測試金鑰為 1x00000000000000000000AA)
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# 授權服務人員 LINE ID 白名單 (多個以逗號隔開)
ADMIN_LINE_IDS="Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 收到新預約時接收 LINE 推播的管理員 ID
ADMIN_NOTIFY_USER_ID="Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# LINE Messaging API Channel Secret (用於驗證 Webhook x-line-signature 防偽簽名，建議以 wrangler secret 設定)
LINE_CHANNEL_SECRET="your_line_channel_secret_here"

# 前端允許之 CORS 來源 (多個請用逗號隔開，支援萬用字元如 https://*.pages.dev)
ALLOWED_ORIGINS="https://*.pages.dev"
